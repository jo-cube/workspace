# Runtime state
workspace/*
!workspace/.gitkeep

# Build-time CA certificates (enterprise laptops)
build-ca-certs/*.crt
build-ca-certs/*.pem
!build-ca-certs/.gitkeep

# Optional mounted runtime config
runtime-config/*.env
!runtime-config/.gitkeep

# Secrets (never commit)
secrets/

# Docker
.env

# OS
.DS_Store
