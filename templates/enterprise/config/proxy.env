# Enterprise proxy configuration.
# This file is valid for Docker Compose env_file and shell sourcing.
# Keep credentials out of URLs; use your platform's secret mechanism instead.

# HTTP_PROXY=http://proxy.internal.example.com:8080
# HTTPS_PROXY=http://proxy.internal.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal.example.com,.example.com
# http_proxy=http://proxy.internal.example.com:8080
# https_proxy=http://proxy.internal.example.com:8080
# no_proxy=localhost,127.0.0.1,.internal.example.com,.example.com
